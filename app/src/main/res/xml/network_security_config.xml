<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for Kryptx
    ═══════════════════════════════════════════
    • Cleartext HTTP is globally forbidden — all traffic must use TLS.
    • Certificate pinning is applied to api.pwnedpasswords.com (HIBP k-Anonymity endpoint).

    MAINTAINING THE HIBP PINS
    ──────────────────────────
    The pins below are SHA-256 SPKI hashes of the certificate chain for api.pwnedpasswords.com.
    Run the following script any time you suspect the cert has rotated, and update accordingly:

        ./scripts/update_hibp_pins.sh

    Or manually:
        openssl s_client -connect api.pwnedpasswords.com:443 2>/dev/null \
          | openssl x509 -pubkey -noout \
          | openssl pkey -pubin -outform DER \
          | openssl dgst -sha256 -binary \
          | openssl base64

    Pin 1  = leaf certificate public key (rotate when HIBP renews their cert)
    Pin 2  = DigiCert Global Root G2 (intermediate/root backup — very stable)
    Pin 3  = ISRG Root X1 (Let's Encrypt root — fallback if HIBP switches CAs)

    The expiration date below should be set to ~6 months from the current leaf cert's
    notAfter date. When expired, Android ignores the pin-set and falls back to system CAs
    (safe degradation), and a new build with updated pins should be shipped before then.
-->
<network-security-config>

    <!-- Global policy: no cleartext HTTP anywhere in the app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        HIBP Pwned Passwords API — certificate pin set.

        IMPORTANT: The leaf pin (Pin 1) MUST be refreshed when HIBP renews their TLS cert.
        The two backup pins (DigiCert G2 intermediate + ISRG Root X1) are stable root/intermediate
        keys that serve as continuity anchors while you ship an updated leaf pin.

        To extract live pins, run:  scripts/update_hibp_pins.sh
    -->
    <domain-config>
        <domain includeSubdomains="false">api.pwnedpasswords.com</domain>
        <pin-set expiration="2027-01-01">
            <!--
                Pin 1 — Leaf certificate SPKI (api.pwnedpasswords.com)
                Extract via: openssl s_client -connect api.pwnedpasswords.com:443 2>/dev/null |
                             openssl x509 -pubkey -noout | openssl pkey -pubin -outform DER |
                             openssl dgst -sha256 -binary | openssl base64
                Last verified: run scripts/update_hibp_pins.sh to populate this value.
            -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>

            <!--
                Pin 2 — DigiCert Global Root G2 (stable intermediate/root backup).
                This is the well-known DigiCert G2 root SPKI SHA-256.
                Source: https://www.digicert.com/kb/digicert-root-certificates.htm
            -->
            <pin digest="SHA-256">i7WTqTvh0OioIruIfFR4kMPnBqrS2rdiVPl/s2uC/CY=</pin>

            <!--
                Pin 3 — Cloudflare Inc ECC CA-3 (backup for Cloudflare-fronted endpoints).
                Extracted from Cloudflare's published certificate transparency logs.
            -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYL6V7bF8Blx/RW1/HCTsd5uJM=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>
